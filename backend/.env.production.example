# Production Environment Variables
# Copy this file untuk production deployment
# JANGAN commit file ini dengan nilai sebenarnya!

# Server Configuration
NODE_ENV=production
PORT=5000

# Database Configuration (akan di-set otomatis oleh Railway/Render)
DB_HOST=your-database-host
DB_PORT=3306
DB_NAME=railway
DB_USERNAME=root
DB_PASSWORD=your-db-password
DB_SSL=true

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=uploads

# File Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB
MAX_FILES=5

# CORS Configuration (ganti dengan Vercel URL Anda)
CORS_ORIGIN=https://your-app.vercel.app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Authentication (GENERATE RANDOM VALUES!)
# Generate with: openssl rand -base64 32
JWT_SECRET=GENERATE-RANDOM-32-CHARS-OR-MORE-FOR-PRODUCTION
JWT_EXPIRES_IN=7d

# Encryption (GENERATE RANDOM VALUES!)
# Generate with: openssl rand -base64 32
ENCRYPTION_SECRET=GENERATE-RANDOM-32-CHARS-OR-MORE-FOR-PRODUCTION

# ═══════════════════════════════════════════
# IMPORTANT SECURITY NOTES:
# ═══════════════════════════════════════════
# 1. NEVER use default/example values in production
# 2. Generate strong random values for JWT_SECRET and ENCRYPTION_SECRET
# 3. Keep DB_PASSWORD secure
# 4. Update CORS_ORIGIN dengan exact Vercel URL
# 5. Enable DB_SSL=true untuk cloud databases
